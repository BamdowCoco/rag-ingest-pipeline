# ===== 应用 =====
APP_NAME=企业知识库 RAG 接入管道
DEBUG=false
API_PORT=8000
LOG_LEVEL=INFO

# ===== MySQL =====
# host/port 不在这里 —— 由 docker-compose 的 environment 指定成服务名（mysql:3306）。
# 这个项目只在 compose 里跑，所以口径只有一份；这里只放账号与库名。
DB_USER=app
DB_PASSWORD=app
DB_NAME=rag_ingest

# ===== Redis =====
# 同理：host/port/db 也都在 compose 里（redis:6379、db 0；测试容器用 db 15）

# ===== 业务参数 =====
CACHE_TTL=60
LOCK_TTL_MS=10000
# ===== 后台任务 =====
RECLAIM_INTERVAL_SECONDS=60
RECLAIM_AFTER_SECONDS=300

# ===== enrich（阶段 H）=====
# provider 四档：rule（纯 Python）/ model（自定契约的 HTTP 上游）/ openai_compat（OpenAI 兼容）/ off
ENRICH_PROVIDER=rule
# `model` 档：上游地址。compose 里已指到 model 服务（http://model:8000/enrich）；换上游时改它
ENRICH_MODEL_URL=http://model:8000/enrich
# `openai_compat` 档：基址 + 端点路径 + 要哪个模型 + 可选的 key
ENRICH_OPENAI_BASE_URL=http://model:8000
# 端点路径做成可配：多数厂商是 /v1/chat/completions，但智谱 GLM 是 /api/paas/v4/chat/completions
ENRICH_OPENAI_PATH=/v1/chat/completions
ENRICH_MODEL_NAME=fake-model
# key 留空即可 —— 自建推理（Ollama / vLLM）不需要，云厂商兼容端点才需要
ENRICH_API_KEY=
# 让上游按 JSON 约束输出（DeepSeek / 通义 / GLM 支持；不支持的服务会 400 → 那一档不可用）
ENRICH_JSON_MODE=false
# 发给上游的正文先截到这个长度（首段 + 尾段）—— 长文档按输入全长计费，整篇发是白烧钱
ENRICH_SAMPLE_LIMIT=4000
# 摘要不该无限长；也是成本闸门
ENRICH_MAX_TOKENS=512
# 默认 5 秒对云厂商太紧 —— 而超时的表现是"静默回落到规则"，会被误判成"没接上"，接真厂商时调大
ENRICH_TIMEOUT_SECONDS=5
ENRICH_INTERVAL_SECONDS=30
ENRICH_BATCH_SIZE=50

# ---- 接真厂商的例子（以 DeepSeek 为例）----
# 把上面几项换成这组，再把 key 填进你的 .env（别填进这个文件 —— 它是要提交的）：
#   ENRICH_PROVIDER=openai_compat
#   ENRICH_OPENAI_BASE_URL=https://api.deepseek.com
#   ENRICH_MODEL_NAME=deepseek-chat
#   ENRICH_JSON_MODE=true
#   ENRICH_TIMEOUT_SECONDS=20
# 完整步骤（含"先直接打一次厂商 API"的探活与判别特征）见 README 快速开始第 6 节。
