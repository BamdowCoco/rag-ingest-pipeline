# ===== 应用 =====
APP_NAME=AI 舆情数据管道 API
DEBUG=false
API_PORT=8000
LOG_LEVEL=INFO

# ===== MySQL =====
# 本地开发连宿主机映射端口(3307)；容器内由 docker-compose 的 environment 覆盖成 mysql:3306
DB_HOST=localhost
DB_PORT=3307
DB_USER=app
DB_PASSWORD=app
DB_NAME=opinion

# ===== Redis =====
# 本地 6380；容器内覆盖成 redis:6379
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# ===== 业务参数 =====
CACHE_TTL=60
LOCK_TTL_MS=10000
